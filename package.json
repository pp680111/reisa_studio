{
  "name": "uzawa-reisa-studio",
  "version": "0.1.0",
  "private": true,
  "description": "以 Agent 会话为主入口，通过独立功能模块扩展能力的 AI 聚合应用",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @reisa/desktop dev",
    "dev:desktop": "pnpm --filter @reisa/desktop dev:desktop",
    "build": "pnpm typecheck && pnpm check:boundaries && pnpm --filter @reisa/desktop build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "pnpm --filter @reisa/desktop preview",
    "start": "pnpm --filter @reisa/desktop start",
    "test": "node --test tests/*.test.mjs packages/foundation/test/*.test.mjs packages/agent-adapter/test/*.test.mjs packages/module-host/test/*.test.mjs apps/desktop/test/*.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:desktop": "node tests/electron-smoke.cjs",
    "format": "prettier --write \"{apps,modules,packages,scripts,tests}/**/*.{ts,tsx,mjs,cjs,css,json}\" package.json tsconfig.json tsconfig.base.json",
    "format:check": "prettier --check \"{apps,modules,packages,scripts,tests}/**/*.{ts,tsx,mjs,cjs,css,json}\" package.json tsconfig.json tsconfig.base.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
