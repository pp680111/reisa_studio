{
  "name": "@reisa/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Reisa Studio 桌面主应用：窗口、导航、工作区、模块加载与页面挂载",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@reisa/agent-adapter": "workspace:*",
    "@reisa/foundation": "workspace:*",
    "@reisa/module-host": "workspace:*",
    "@reisa/module-sdk": "workspace:*",
    "@reisa/ui": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@vitejs/plugin-react": "^5.0.0",
    "ai": "^7.0.127",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.0.0"
  }
}
